{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "vtt",
    "ExpiracaoMinutos": 720
  },
  "RateLimiting": {
    "AuthLimite": 10,
    "AuthJanelaSegundos": 60,
    "MovimentosPorSegundo": 20,
    "ChamadasDoHubPorSegundo": 5,
    "TamanhoMaximoDaMensagemDoHub": 32768,
    "UploadsPorMinuto": 30
  },
  "Uploads": {
    "TamanhoMaximoBytes": 5242880,
    "DimensaoMaxima": 4096,
    "PixelsMaximosDaAnimacao": 67108864,
    "CotaBytesPorMesa": 209715200,
    "CotaImagensPorMesa": 100
  },
  "Storage": {
    "UploadsPath": "uploads"
  },
  "App": {
    "PublicBaseUrl": ""
  }
}

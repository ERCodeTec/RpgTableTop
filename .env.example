# Copie para .env (cp .env.example .env) e troque os valores. O .env nunca vai para o git.

# Senha do PostgreSQL. Evite ; e aspas: o valor entra na connection string.
# Vale só na primeira subida; para trocar depois, apague o volume (docker compose down -v).
POSTGRES_PASSWORD=troque-esta-senha

# Chave que assina os tokens de login, com pelo menos 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_ISSUER=vtt
# Validade do login, em minutos (720 = 12 horas).
JWT_EXPIRATION_MINUTES=720

# URL pela qual os jogadores acessam o sistema, usada nos links de convite.
# Vazia, o link usa o endereço pelo qual o Mestre está acessando (localhost ou ngrok).
PUBLIC_BASE_URL=

# ngrok (docker compose --profile ngrok up -d). Token em https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Domínio fixo da sua conta (ex.: algo.ngrok-free.app). Vazio, o endereço muda a cada subida.
NGROK_DOMAIN=

# Production desliga o Swagger: use sempre que a mesa estiver exposta (ngrok ou VPS).
# Development liga o Swagger em /swagger, para quem está programando.
ASPNETCORE_ENVIRONMENT=Production

# Aplica as migrations do banco quando a API sobe.
DATABASE_AUTO_MIGRATE=true

# Portas na sua máquina.
API_PORT=8080
POSTGRES_PORT=5432
# Painel do ngrok em http://localhost:4040
NGROK_INSPECT_PORT=4040
